# ==========================================
# Hospital Management System (HMS) - Config
# ==========================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=super_secret_hospital_jwt_token_key_2026

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_management?retryWrites=true&w=majority
# Example Local MongoDB URI:
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management

# Frontend Client URL
CLIENT_URL=http://localhost:5173
