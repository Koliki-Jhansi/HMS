# Server Configuration
PORT=5000

# JWT Authentication Secret
JWT_SECRET=super_secret_hospital_jwt_token_key_2026

# Database Connection (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hospital_management?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/hospital_management
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
