generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          String         @default("PATIENT") // ADMIN, DOCTOR, PATIENT
  name          String
  phone         String?
  avatar        String?
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  patient       Patient?
  doctor        Doctor?
  notifications Notification[]
}

model Patient {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalRecordNumber    String          @unique
  dateOfBirth            String?
  gender                 String?         // MALE, FEMALE, OTHER
  bloodGroup             String?         // A+, A-, B+, B-, AB+, AB-, O+, O-
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  allergies              String?
  chronicConditions      String?
  insuranceProvider      String?
  insurancePolicyNumber  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  appointments           Appointment[]
  admissions             Admission[]
  prescriptions          Prescription[]
  medicalRecords         MedicalRecord[]
}

model Doctor {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   String
  licenseNumber    String          @unique
  qualification    String
  experienceYears  Int             @default(1)
  consultationFee  Float           @default(50.0)
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bio              String?
  availableDays    String          @default("Monday,Tuesday,Wednesday,Thursday,Friday") // comma-separated
  timeSlots        String          @default("09:00 AM,10:00 AM,11:00 AM,02:00 PM,03:00 PM,04:00 PM") // comma-separated
  roomNumber       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  appointments     Appointment[]
  prescriptions    Prescription[]
  admissions       Admission[]
  medicalRecords   MedicalRecord[]
}

model Department {
  id             String        @id @default(uuid())
  name           String        @unique
  code           String        @unique
  description    String?
  icon           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  doctors        Doctor[]
  appointments   Appointment[]
}

model Ward {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  type        String   @default("GENERAL") // GENERAL, ICU, EMERGENCY, PRIVATE, MATERNITY, PEDIATRIC
  floor       Int      @default(1)
  capacity    Int      @default(10)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds        Bed[]
}

model Bed {
  id         String      @id @default(uuid())
  bedNumber  String      @unique
  wardId     String
  ward       Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  status     String      @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING, MAINTENANCE
  dailyRate  Float       @default(100.0)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  admissions Admission[]
}

model Admission {
  id                String       @id @default(uuid())
  admissionNumber   String       @unique
  patientId         String
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bedId             String
  bed               Bed          @relation(fields: [bedId], references: [id], onDelete: Restrict)
  admittingDoctorId String
  doctor            Doctor       @relation(fields: [admittingDoctorId], references: [id], onDelete: Restrict)
  admissionDate     DateTime     @default(now())
  dischargeDate     DateTime?
  reason            String
  diagnosis         String?
  status            String       @default("ACTIVE") // ACTIVE, DISCHARGED, TRANSFERRED
  dischargeSummary  String?
  totalBill         Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Appointment {
  id                 String        @id @default(uuid())
  appointmentNumber  String        @unique
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointmentDate    String        // YYYY-MM-DD
  timeSlot           String        // e.g. 10:00 AM
  status             String        @default("PENDING") // PENDING, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED, REJECTED
  reason             String
  symptoms           String?
  notes              String?
  rejectionReason    String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  prescription       Prescription?
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique
  appointmentId      String?            @unique
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis          String
  notes              String?
  followUpDate       String?            // YYYY-MM-DD
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String       // e.g., 500mg
  frequency      String       // e.g., Twice a day (1-0-1)
  duration       String       // e.g., 5 days
  route          String       @default("Oral") // Oral, Injection, Topical, IV
  instructions   String?      // e.g., Take after food
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MedicalRecord {
  id           String   @id @default(uuid())
  recordNumber String   @unique
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  title        String
  recordType   String   @default("CONSULTATION") // CONSULTATION, LAB_REPORT, SURGERY, DISCHARGE_SUMMARY, DIAGNOSIS
  notes        String
  attachments  String?  // JSON string or URL
  recordDate   String   // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // APPOINTMENT, ADMISSION, PRESCRIPTION, SYSTEM, BED
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
